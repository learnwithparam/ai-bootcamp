# Copy this file to .env, then fill in the two keys. `bun run setup` fills in the rest.

# The model every product uses, as provider:model. Pick one line.
MODEL=openrouter:openai/gpt-6-luna
# MODEL=anthropic:claude-haiku-5-5

# Get a key at https://openrouter.ai/keys (or https://console.anthropic.com for Anthropic).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# The decision model, used where a product must pick one action and say how sure it is.
DECISION_MODEL=openai/gpt-6-luna-decisions

# Postgres from compose.yaml.
DATABASE_URL=postgres://bootcamp:bootcamp@localhost:5433/bootcamp

# Sign-in. `bun run setup` writes a random secret here.
BETTER_AUTH_SECRET=

# Langfuse from compose.yaml. `bun run setup` writes these keys and creates the project with them.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_ORG_ID=bootcamp
LANGFUSE_INIT_ORG_NAME=AI Bootcamp
LANGFUSE_INIT_PROJECT_ID=bootcamp
LANGFUSE_INIT_PROJECT_NAME=AI Bootcamp
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=learner@bootcamp.local
LANGFUSE_INIT_USER_NAME=Learner
LANGFUSE_INIT_USER_PASSWORD=
